# À copier en docker-compose.yml puis à adapter. Place neofreebox derrière un
# reverse proxy en HTTPS (le cookie de session est Secure), idéalement avec sa
# propre authentification (Authelia, Authentik…). Le serveur doit être sur le
# réseau local de la box : elle ne répond sur mafreebox.freebox.fr que de là.
#
# Le jeton d'application vient de `neofreebox pair -o freebox_app_token`, lancé
# une fois sur ce réseau pendant que tu valides la demande sur l'écran de la
# box. Donne le fichier à l'UID 65532 (l'utilisateur de l'image), en mode 0400.
services:
  neofreebox:
    image: ghcr.io/neotoxicfr/neofreebox:latest
    container_name: neofreebox
    restart: unless-stopped
    environment:
      NEOFREEBOX_APP_TOKEN_FILE: /run/secrets/freebox_app_token
      # NEOFREEBOX_BOX_URL: https://mafreebox.freebox.fr
      # NEOFREEBOX_READ_ONLY: "true"   # refuse toute écriture vers la box (démonstration, audit)
    secrets:
      - freebox_app_token
    volumes:
      - ./data:/data
    ports:
      - "127.0.0.1:8080:8080"
    read_only: true
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true

secrets:
  freebox_app_token:
    file: ./secrets/freebox_app_token
